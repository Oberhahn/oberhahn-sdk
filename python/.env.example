# Copy to `.env` and fill in. Used only by the smoke scripts (scripts/smoke*.py),
# never by the published package. `.env` is git-ignored — never commit real keys.

# OBERHAHN deployment the smoke test posts to (API root incl. /v0) + an oak_ key.
OBERHAHN_BASE_URL=https://app.oberhahn.com/v0
OBERHAHN_API_KEY=oak_...

# One provider credential — the smoke picks a provider from whichever is set,
# or force it with OBERHAHN_SMOKE_PROVIDER=openai|anthropic|bedrock.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Bedrock: standard AWS creds. Region must match the model's availability.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Optional overrides
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-4-5
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# OBERHAHN_SMOKE_PROVIDER=bedrock
